; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wickmere"
config/description="An original open-world action RPG: warm villages that remember you, wild country between them, and old deep places gone quiet."
config/version="0.1.0"
run/main_scene="res://ui/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=false
config/icon="res://icon.svg"

[autoload]

ErrorLog="*res://core/error_log.gd"
Log="*res://core/log.gd"
ContentDB="*res://core/content_db.gd"
EventBus="*res://core/event_bus.gd"
Settings="*res://core/settings.gd"
WorldClock="*res://core/world_clock.gd"
GameState="*res://core/game_state.gd"
SaveSystem="*res://core/save_system.gd"
Hearth="*res://systems/hearth/hearth_system.gd"
Interiors="*res://systems/interiors/interior_manager.gd"
Social="*res://systems/social/social.gd"
Music="*res://systems/audio/music_director.gd"
Ambience="*res://systems/audio/ambience_mixer.gd"
Foley="*res://systems/audio/foley.gd"
UI="*res://ui/ui.gd"
Debug="*res://tools_gd/debug_console.tscn"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0
settings/stdout/print_fps=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="npc"
3d_physics/layer_5="interactable"
3d_physics/layer_6="hurtbox"
3d_physics/layer_7="hitbox"
3d_physics/layer_8="projectile"
3d_physics/layer_9="trigger"
3d_physics/layer_10="camera_blocker"
3d_physics/layer_11="terrain"
3d_physics/layer_12="water"
3d_render/layer_1="world"
3d_render/layer_2="first_person_arms"
3d_render/layer_3="ui_3d"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/physics_jitter_fix=0.0
3d/default_gravity=9.81

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.16, 0.17, 0.2, 1)
textures/default_filters/anisotropic_filtering_level=3
occlusion_culling/use_occlusion_culling=true
limits/opengl/max_lights_per_object=12
mesh_lod/lod_change/threshold_pixels=4.0
limits/opengl/max_renderable_elements=32768

[shader_globals]

wm_wind_strength={
"type": "float",
"value": 0.3
}
wm_wind_dir={
"type": "vec3",
"value": Vector3(0.8, 0, 0.6)
}
wm_wetness={
"type": "float",
"value": 0.0
}
wm_time_of_day={
"type": "float",
"value": 8.0
}
wm_region_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
wm_night={
"type": "float",
"value": 0.0
}
wm_sun_dir={
"type": "vec3",
"value": Vector3(0.5, 0.6, 0.2)
}
wm_sun_color={
"type": "vec3",
"value": Vector3(1.2, 1.1, 0.95)
}
wm_moon_dir={
"type": "vec3",
"value": Vector3(-0.5, 0.6, -0.2)
}
wm_moon_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wm_sky_zenith={
"type": "vec3",
"value": Vector3(0.04, 0.16, 0.5)
}
wm_sky_horizon={
"type": "vec3",
"value": Vector3(0.5, 0.64, 0.78)
}
