[
  {"id": "core:boss/old_hound", "resists": {"frost": 0.35, "slash": -0.2, "fire": -0.3}, "extends": "core:enemy/down_wolf", "name": "The Old Hound", "archetype": "boss", "arena": "core:poi/hounds_swallet", "region": "core:region/hearthvale", "tint": "#d8d2c2", "scale": 2.1, "lore": "The Vale says the Chalk Hound was cut on the down over something already lying there, and scoured white every seventh summer to keep it lying down. Down wolves are lean and grey-gold and work in fours. This one is as white as scoured chalk and works alone, and the wolves of Hound Down come to it the way hounds come to their master's whistle. It has been lying on a scourer's cord for seven years, keeping it taut.", "stats": {"hp": 420, "stamina": 160, "poise": 120, "armour": 6, "speed": 4.2}, "behaviour": {"engage_range": 2.8, "circle": 0.7, "retreat_threshold": 0.0, "patience": 3.0, "leash": 60.0, "hyper_armour": 20.0, "aggression": 0.7, "strafe_speed": 1.0, "flank": false}, "attacks": [{"name": "maul", "clip": "Attack_1", "weapon_class": "bite", "damage": 20.0, "poise_damage": 22.0, "range": 2.8, "telegraph": 0.6, "hit_window": 0.18, "recovery": 0.6, "cooldown": 1.8, "gcd": 0.5, "weight": 3.0, "lunge": 2.4}, {"name": "the_long_leap", "clip": "Attack_2", "weapon_class": "bite", "damage": 28.0, "poise_damage": 40.0, "heavy": true, "range": 6.0, "min_range": 2.8, "telegraph": 1.0, "hit_window": 0.2, "recovery": 1.0, "cooldown": 6.0, "gcd": 1.0, "weight": 1.0, "lunge": 6.5, "knockdown": true, "knockback": 3.0}], "phases": [{"name": "asleep on the cord", "hp": 1.0, "aggression": 0.6}, {"name": "the eye opens", "hp": 0.5, "aggression": 0.9, "speed": 4.8, "say": "It throws back its head and gives tongue, and from every bore of the swallet the pack answers and comes."}], "marks": [120, 220], "loot": "core:loot/wolf_carcass", "drops": ["core:item/old_hounds_tooth"], "tags": ["beast", "wolf", "boss"]},
  {"id": "core:boss/the_gaffer", "extends": "core:enemy/hedge_wight", "name": "The Gaffer", "archetype": "boss", "arena": "core:poi/knappers_deep", "region": "core:region/hearthvale", "tint": "#d4cebd", "scale": 1.5, "height": 2.75, "radius": 0.48, "appearance": {"seed": 4377, "culture": "vale", "skin": "porcelain", "hair_colour": "white", "build": 0.6, "feminine": 0.0, "height": 1.8, "age": 0.75, "parts": {"torso": "tunic", "legs": "leg_wraps", "feet": "boots", "belt": "belt_knife", "attachment": "apron", "headgear": "miners_hat", "hair": "short", "beard": "stubble"}, "palette": {"primary": "b6b0a0", "secondary": "4e4a42", "leather": "8a8274", "metal": "a8a49a", "trim": "e8dcc0"}}, "holds": "core:item/overmans_pick", "carry": [{"at": "Head", "pos": [0.0, 1.8, 0.15], "light": {"colour": "#ffcf80", "energy": 1.0, "range": 6.0, "pos": [0.0, 0.0, 0.0]}, "flame": {"size": 0.012, "colour": "#ffe0a0"}}], "aura": {"motes": {"colour": "#e6e0d0", "count": 24, "size": 0.03, "rise": -0.06, "spread": 0.5, "height": 2.7, "mix": true}}, "resists": {"pierce": 0.25, "slash": 0.1, "blunt": -0.2, "fire": -0.15}, "lore": "Abram Knapper was overman of the night shift at Knappers' Deep, and an overman's work is to count his shift down the ladder and count them up again. The Fall came between the two counts. He has been at the far face ever since with the tally-stick in his fist, knocking for the shift, and the shift knocking back, and the count never comes out right because there is always one more man on the far side of the chalk than he can see. He does not know you are not the eighth.", "stats": {"hp": 500, "stamina": 170, "poise": 140, "armour": 9, "speed": 2.0}, "behaviour": {"engage_range": 3.1, "circle": 0.05, "retreat_threshold": 0.0, "patience": 3.0, "leash": 60.0, "hyper_armour": 26.0, "aggression": 0.75, "strafe_speed": 0.3}, "attacks": [{"name": "pick_and_turn", "clip": "Attack_2H_Light_1", "weapon_class": "axe", "damage": 22.0, "poise_damage": 30.0, "heavy": true, "hyper_ar