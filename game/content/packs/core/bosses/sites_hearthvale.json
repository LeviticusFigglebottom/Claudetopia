r": true, "range": 3.2, "telegraph": 1.2, "hit_window": 0.22, "recovery": 1.05, "cooldown": 6.0, "gcd": 1.0, "weight": 2.0, "lunge": 2.6, "knockdown": true, "knockback": 3.2}]}], "marks": [260, 420], "loot": "core:loot/tithe_strongbox", "drops": ["core:item/barrow_kings_ring"], "tags": ["human", "humanoid", "bandit", "brute", "boss"]},
  {"id": "core:boss/barrow_wife", "extends": "core:enemy/hedge_wight", "name": "Ebba Crowle, the Barrow-Wife", "archetype": "boss", "arena": "core:poi/wake_barrow", "region": "core:region/hearthvale", "tint": "#8f8a7a", "scale": 1.4, "height": 2.4, "radius": 0.42, "appearance": {"seed": 4463, "culture": "vale", "skin": "porcelain", "hair_colour": "white", "build": 0.2, "feminine": 1.0, "height": 1.7, "age": 0.95, "parts": {"torso": "dress", "back": "torn_cloak", "headgear": "wimple", "belt": "bead_ropes", "feet": "shoes", "hair": "bun"}, "palette": {"primary": "34322e", "secondary": "c9c3b0", "leather": "2e2a24", "metal": "5f6259", "trim": "e4dece"}}, "holds": {"model": "weapons/crook_thorn", "tags": ["two_handed"]}, "aura": {"rim": "#a8c8e8", "energy": 0.9, "power": 2.6, "pulse": 0.4, "pulse_rate": 0.9, "motes": {"colour": "#101016", "count": 26, "size": 0.07, "rise": 0.16, "spread": 0.7, "height": 1.2, "mix": true}, "light": {"colour": "#9ab8e0", "energy": 0.45, "range": 5.0, "height": 1.6}}, "resists": {"frost": 0.5, "pierce": 0.2, "fire": -0.3, "blunt": -0.1}, "lore": "The last barrow-wife of Wake Barrow went down in the Ash Winter with her lamp and the winter's dead, more than she could sit with, and had the stone rolled across behind her. She has been sitting the wake since: three nights each, one after another, two hundred years of nights, the lamp at her side. The lamp has gone out. She does not know whose wake she is at now, or that it is her own, and she will not have it disturbed by anybody who has not come to sit.", "stats": {"hp": 480, "stamina": 170, "poise": 120, "armour": 7, "speed": 2.3}, "behaviour": {"engage_range": 3.0, "circle": 0.25, "retreat_threshold": 0.0, "patience": 2.5, "leash": 55.0, "hyper_armour": 18.0, "aggression": 0.75, "strafe_speed": 0.5}, "attacks": [{"name": "crook_sweep", "clip": "Attack_2H_Light_1", "weapon_class": "staff", "damage": 19.0, "poise_damage": 26.0, "range": 3.2, "telegraph": 0.85, "hit_window": 0.2, "recovery": 0.8, "cooldown": 2.6, "gcd": 0.8, "weight": 3.0, "lunge": 1.6}, {"name": "the_hook", "clip": "Attack_2H_Light_2", "weapon_class": "staff", "damage": 15.0, "poise_damage": 30.0, "range": 3.4, "telegraph": 0.6, "hit_window": 0.18, "recovery": 0.7, "cooldown": 4.0, "gcd": 0.7, "weight": 1.5, "lunge": 1.2, "knockback": 2.0}, {"name": "lay_them_out", "clip": "Attack_2H_Heavy", "weapon_class": "staff", "damage": 30.0, "poise_damage": 52.0, "heavy": true, "hyper_armour": true, "range": 3.2, "telegraph": 1.3, "hit_window": 0.22, "recovery": 1.1, "cooldown": 6.5, "gcd": 1.0, "weight": 2.0, "lunge": 2.4, "knockdown": true, "knockback": 3.0}], "phases": [{"name": "the wake", "hp": 1.0, "aggression": 0.7, "say": "She gets up off her stool slowly, the way you get up when you have been sitting a long time, and puts herself between you and her dead."}, {"name": "the lamp goes out", "hp": 0.5, "aggression": 0.9, "speed": 2.6, "say": "She cups her hand round the dead lamp as if it were still lit and blows on it, and the dark comes up out of the niches, and the cold with it, and the wakeless get up off their benches.", "attacks": [{"name": "the_dark_comes_up", "kind": "burst", "clip": "Attack_2H_Heavy", "weapon_class": "staff", "kind_damage": "frost", "radius": 8.0, "range": 7.0, "damage": 15.0, "poise_damage": 50.0, "unparryable": true, "hyper_armour": true, "telegraph": 1.7, "hit_window": 0.22, "recovery": 1.4, "cooldown": 18.0, "gcd": 1.3, "weight": 1.5, "statuses": [{"id": "chilled", "duration": 6.0, "magnitude": 1.0}], "summons": {"enemy": "core:enemy/wakeless", "count": 2, "radius": 6.0, "cap": 3}}, {"name": "crook_sweep", "clip": "Attack_2H_Light_1", "weapon_class": "staff", "damage": 21.0, "poise_damage": 28.0, "range": 3.2, "telegraph": 0.75, "hit_window": 0.2, "recovery": 0.75, "cooldown": 2.4, "gcd": 0.75, "weight": 3.0, "lunge": 1.8}, {"name": "lay_them_out", "clip": "Attack_2H_Heavy", "weapon_class": "staff", "damage": 32.0, "poise_damage": 56.0, "heavy": true, "hyper_armo