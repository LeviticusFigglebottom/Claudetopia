  {"id": "core:boss/wassail_king", "extends": "core:enemy/hedge_wight", "name": "Hob Applegarth, the Wassail King", "archetype": "boss", "arena": "core:poi/wassail_knap", "region": "core:region/hearthvale", "tint": "#8a5a3a", "scale": 1.45, "height": 2.6, "radius": 0.46, "appearance": {"seed": 4789, "culture": "vale", "skin": "fair", "hair_colour": "auburn", "build": 0.8, "feminine": 0.0, "height": 1.82, "age": 0.6, "parts": {"torso": "coat", "back": "ragged_cloak", "legs": "trousers", "feet": "boots", "belt": "cord_beads", "headgear": "crude_crown", "hair": "tousled", "beard": "full_beard"}, "palette": {"primary": "4d6a2a", "secondary": "7a2a1c", "leather": "4a3420", "metal": "b89a48", "trim": "d8c070"}}, "holds": "core:item/old_hobs_cudgel", "aura": {"rim": "#ffd0a0", "energy": 0.6, "power": 2.4, "pulse": 0.5, "pulse_rate": 1.4, "motes": {"colour": "#f4e6d8", "count": 30, "size": 0.05, "rise": -0.12, "spread": 1.1, "height": 2.4, "mix": true}, "light": {"colour": "#ffb070", "energy": 0.5, "range": 5.0, "height": 1.8}}, "resists": {"frost": 0.2, "fire": -0.25, "blunt": 0.1}, "lore": "Hob Applegarth was crowned Wassail King on the last Twelfth Night the Great Press kept, and at dawn he would not give the crown back, because the singing was too good and it was not finished. The press-master barred the cellar on him and his wassailers by the rules, and the cellar kept him. Forty years he has kept the revel going round the Mother Vat, and this spring it got loud enough to wake the orchard over it. He is a good King. He is loud and kind and he will not let anybody leave.", "stats": {"hp": 520, "stamina": 180, "poise": 125, "armour": 7, "speed": 2.4}, "behaviour": {"engage_range": 2.8, "circle": 0.35, "retreat_threshold": 0.0, "patience": 1.8, "leash": 55.0, "hyper_armour": 18.0, "aggression": 0.8, "strafe_speed": 0.6}, "attacks": [{"name": "wake_the_tree", "clip": "Attack_1H_Light_1", "weapon_class": "mace", "damage": 18.0, "poise_damage": 26.0, "range": 2.9, "telegraph