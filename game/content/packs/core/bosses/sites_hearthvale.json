  {"id": "core:boss/digger_king", "extends": "core:enemy/larkbourne_bruiser", "name": "Dunstan Spade, the Digger-King", "archetype": "boss", "arena": "core:poi/hum_stone", "region": "core:region/hearthvale", "tint": "#6a5a44", "scale": 1.46, "height": 2.7, "radius": 0.56, "breadth": 1.12, "appearance": {"seed": 4419, "culture": "vale", "skin": "wheat", "hair_colour": "dark_brown", "build": 0.9, "feminine": 0.0, "height": 1.84, "age": 0.45, "parts": {"torso": "coat", "back": "cloak", "legs": "trousers", "feet": "boots", "hands": "gloves", "belt": "belt_knife", "headgear": "crude_crown", "hair": "tousled", "beard": "full_beard"}, "palette": {"primary": "5a2430", "secondary": "3a3026", "leather": "3a2a1e", "metal": "c8a04a", "trim": "8a1a22"}, "jewellery": [{"kind": "torc", "on": "neck", "metal": "gold"}, {"kind": "ring", "on": "hands", "metal": "gold"}, {"kind": "bracelet", "on": "wrists", "metal": "gold"}]}, "holds": {"model": "weapons/spade_iron", "tags": ["two_handed"]}, "resists": {"blunt": 0.15, "silence": 0.6, "pierce": -0.15}, "lore": "Dunstan Spade opened Orm's Long Barrow with his own hands and sold Orm's grave-goods in Tollmere before the turf had settled, and the Boys started calling him king as a joke and then not as a joke. He went down the Hum Stone's throat after the biggest bronze in it, a plate the Builders hung at the bottom like a bell with no curve, and the Hush's dead came down behind him. He found out that while the plate rings, they stand still and listen. He has been ringing it since the spring. He has not slept much. He would very much like you to put down your weapon and take a turn.", "stats": {"hp": 460, "stamina": 180, "poise": 125, "armour": 9, "speed": 2.7}, "behaviour": {"engage_range": 2.9, "circle": 0.2, "retreat_threshold": 0.0, "patience": 2.5, "leash": 55.0, "hyper_armour": 20.0, "aggression": 0.8, "strafe_speed": 0.5}, "attacks": [{"name": "spade_cut", "clip": "Attack_2H_Light_1", "weapon_class": "hammer", "damage": 20.0, "poise_d