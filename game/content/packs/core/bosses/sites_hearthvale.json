  {"id": "core:boss/kern_mother", "extends": "core:enemy/hedge_wight", "name": "The Kern Mother", "archetype": "boss", "arena": "core:poi/great_barn", "region": "core:region/hearthvale", "tint": "#c2a457", "scale": 1.9, "height": 3.4, "radius": 0.6, "appearance": {"seed": 4791, "culture": "vale", "skin": "wheat", "hair_colour": "ginger", "build": 0.5, "feminine": 1.0, "height": 1.8, "age": 0.5, "parts": {"torso": "dress", "back": "shawl", "legs": "long_skirt", "feet": "shoes", "belt": "cord_beads", "headgear": "crude_crown", "hair": "long"}, "palette": {"primary": "c8a858", "secondary": "8a6a2e", "leather": "6a4a22", "metal": "d8c070", "trim": "e8d8a0"}}, "holds": {"model": "weapons/scythe_ashen", "tags": ["two_handed"]}, "aura": {"rim": "#ffe0a0", "energy": 0.5, "power": 2.4, "pulse": 0.3, "pulse_rate": 0.7, "motes": {"colour": "#e8d090", "count": 34, "size": 0.05, "rise": -0.2, "spread": 1.2, "height": 3.0, "mix": true}}, "resists": {"fire": -0.5, "pierce": 0.4, "frost": 0.1}, "lore": "The last sheaf of the last harvest the Great Barn held, plaited into a kern-baby with a crown of corn and hung from the tie-beam over winter to keep the harvest's life until spring. Nobody came in spring. Fifty winters she has hung in the dark over the rotting tithe with the year's life in her and nowhere to put it, and she has grown, a sheaf at a time, and taken the reapers who brought her in for her household. She wants to be carried out to a furrow. She will cut down anybody who does not carry her.", "stats": {"hp": 560, "stamina": 190, "poise": 140, "armour": 5, "speed": 2.2}, "behaviour": {"engage_range": 3.4, "circle": 0.2, "retreat_threshold": 0.0, "patience": 2.2, "leash": 55.0, "hyper_armour": 20.0, "aggression": 0.75, "strafe_speed": 0.45}, "attacks": [{"name": "the_swathe", "clip": "Attack_2H_Light_1", "weapon_class": "scythe", "damage": 20.0, "poise_damage": 28.0, "range": 3.6, "telegraph": 0.9, "hit_window": 0.22, "recovery": 0.85, "cooldown": 2.6, "gcd": 0.8, "weight": 3.0, "lunge": 1.6}, {"name": "gleaning", "clip": "Attack_2H_Light_2", "weapon_class": "scythe", "damage": 15.0, "poise_damage": 22.0, "range": 3.2, "telegraph": 0.6, "hit_window": 0.18, "recovery": 0.7, "cooldown": 3.6, "gcd": 0.7, "weight": 1.5, "lunge": 1.3, "statuses": [{"id": "bleeding", "duration": 5.0, "magnitude": 1.0}]}, {"name": "harvest_home", "clip": "Attack_2H_Heavy", "weapon_class": "scythe", "damage": 32.0, "poise_damage": 56.0, "heavy": true, "hyper_armour": true, "range": 3.6, "telegraph": 1.35, "hit_window": 0.24, "recovery": 1.15, "cooldown": 6.5, "gcd": 1.0, "weight": 2.0, "lunge": 2.6, "knockdown": true, "knockback": 3.0}], "phases": [{"name": "the last sheaf", "hp": 1.0, "aggression": 0.7, "say": "The great kern-baby on the tie-beam unbends, and steps down onto the threshing floor of the undercroft as tall as the beam she hung from, and lifts the reaping-hook the reapers bound into her arm."}, {"name": "the chaff", "hp": 0.5, "aggression": 0.95, "speed": 2.6, "say": "She shakes herself like a sheaf shaken out, and the chaff goes up in a storm, and where it settles in the rotten grain, men of straw stand up.", "attacks": [{"name": "the_chaff", "kind": "burst", "clip": "Attack_2H_Heavy", "weapon_class": "scythe", "radius": 8.0, "range": 7.0, "damage": 13.0, "poise_damage": 46.0, "unparryable": true, "hyper_armour": true, "telegraph": 1.6, "hit_window": 0.22, "recovery": 1.3, "cooldown": 18.0, "gcd": 1.3, "weight": 1.5, "statuses": [{"id": "stagger", "duration": 1.0, "magnitude": 1.0}], "summons": {"enemy": "core:enemy/sheaf_man", "count": 2, "radius": 6.0, "cap": 3}}, {"name": "the_swathe", "clip": "Attack_2H_Light_1", "weapon_class": "scythe", "damage": 22.0, "poise_damage": 30.0, "range": 3.6, "telegraph": 0.8, "hit_window": 0.22, "recovery": 0.8, "cooldown": 2.4, "gcd": 0.8, "weight": 3.0, "lunge": 1.8}, {"name": "harvest_home", "clip": "Attack_2H_Heavy", "weapon_class": "scythe", "damage": 34.0, "poise_damage": 58.0, "heavy": true, "hyper_arm