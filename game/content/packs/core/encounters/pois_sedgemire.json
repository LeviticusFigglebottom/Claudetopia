               "killing_costs": {"faction": "core:faction/reed_council", "reputation": -8,
                                 "notice": "The reedfolk feed the Sallow King's sallowjaws so they nest nowhere else. The Reed Council will hear who killed one."}}],
   "lies": [{"item": "core:item/note_sallow_king_feeding_tally"}]},
