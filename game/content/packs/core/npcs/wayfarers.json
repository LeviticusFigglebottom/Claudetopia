  {
    "id": "core:npc/hobb_pennick",
    "name": "Hobb Pennick",
    "home_place": "core:place/merrowby",
    "no_radiant": true,
    "dialogue": "core:dialogue/hobb_pennick",
    "bio": "Walks the Pilgrim Road from Merrowby market to Pilgrim's Ash and back, three days out and four home, with a pack of what the Vale has too much of and the camp at the ash has too little of: candles, rope, a clean shirt. He has done it nineteen years and has never once been further south than the Glass Bridge.",
    "unique_habit": "Knocks twice on every waystone he passes with the brass ferrule of his stick, and once more on the ones that have lost their bowls.",
    "personality": {
      "traits": [
        "gossip",
        "generous",
        "brave",
        "humble"
      ]
    },
    "appearance": {
