  {
    "id": "core:npc/oswy_fenn",
    "name": "Oswy Fenn",
    "home_place": "core:place/last_camp",
    "no_radiant": true,
    "dialogue": "core:dialogue/oswy_fenn",
    "bio": "A pilgrim of eleven years' standing at the Last Camp who has never gone down the Stair. Every morning he walks to the Choir and says the names of the villages on the Wardens' Roll to the twelve colossi, one village to each, and every afternoon he walks back to the camp to eat, and at dusk he goes again, because a colossus should not be left with nobody to talk to at night.",
    "unique_habit": "Bows to each of the twelve colossi in turn, left to right, and if he loses his place starts again from the first, however long it takes.",
    "personality": {
      "traits": [
        "pious",
        "humble",
        "timid",
        "kind"
      ]
    },
    "appearance": {
      "seed": 9204,
      "build": "stooped_thin",
      "age": 67.0,
      "feminine": 0.0,
      "hair": "white_and_long_under_a_grey_hood",
      "notes": "pilgrim grey gone to rags at the hem, a bell with its clapper tied in wool at his belt, bare feet, a staff of Greyfold ash cut before the grey"
    },
    "tags": [
      "wayfarer"
    ],
