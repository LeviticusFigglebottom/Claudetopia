      "build": "round_quick",
      "age": 46.0,
      "feminine": 0.0,
      "hair": "sandy_thinning_under_a_felt_cap",
      "notes": "a pedlar's pack on a frame taller than his head, tin cups and candle-bundles clacking off its sides, a Merrowby market token on a string"
    },
    "tags": [
      "wayfarer"
    ],
