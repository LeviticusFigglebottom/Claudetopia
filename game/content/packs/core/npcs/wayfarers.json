  {
    "id": "core:npc/ysolde_crane",
    "name": "Ysolde Crane",
    "home_place": "core:place/wardens_rest",
    "no_radiant": true,
    "dialogue": "core:dialogue/ysolde_crane",
    "bio": "The youngest Warden on the Rest's roll, sent every day down the wet road to Nauvissa because she is the only one the reedfolk will let past the Boardwalk Gate without a fee. She comes back with news of the delta, eels in a bag, and a new word in the reed tongue, which she uses on the sergeant.",
    "unique_habit": "Sounds every plank of the Boardwalk Gate with the iron foot of her staff on the way in and on the way out, and can tell you by the note which ones the reedfolk have replaced since yesterday.",
    "personality": {
      "traits": [
        "proud",
        "gossip",
        "brave",
        "generous"
      ]
    },
    "appearance": {
      "seed": 9203,
      "build": "tall_rangy",
      "age": 29.0,
      "feminine": 1.0,
      "hair": "black_in_a_warden_braid",
      "notes": "Warden green with a reedfolk eel-skin cloak over it against the wet, a long staff shod with iron for sounding boardwalk, mud to the knee on both sides"
    },
    "tags": [
      "wayfarer"
    ],
    "schedule": [
