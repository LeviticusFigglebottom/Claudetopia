  {
    "id": "core:npc/bettony_sallow",
    "name": "Bettony Sallow",
    "home_place": "core:place/pilgrims_ash",
    "no_radiant": true,
    "dialogue": "core:dialogue/bettony_sallow",
    "bio": "Bakes at Pilgrim's Ash before dawn and carries the loaves west along the Greyfold road, two baskets on a yoke, to lay a loaf at each place on the long tables in Greyfold where the meal was never finished. Nobody asked her to. The loaves are gone by the next morning, and she has stopped asking where.",
    "unique_habit": "Lays the loaves at Greyfold's tables in the order the families sat, from a list in her head she learned from the carved names on the benches, and will not lay one out of turn.",
    "personality": {
      "traits": [
        "kind",
        "quiet",
        "generous",
        "brave"
      ]
    },
    "appearance": {
      "seed": 9205,
