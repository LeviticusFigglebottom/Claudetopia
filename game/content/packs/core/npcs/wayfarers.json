  {
    "id": "core:npc/garth_oakes",
    "name": "Garth Oakes",
    "home_place": "core:place/wardens_rest",
    "no_radiant": true,
    "dialogue": "core:dialogue/garth_oakes",
    "bio": "Warden of the west road: he walks from Wardens' Rest to the West Walk every morning, stands the gate with the Order's knight until noon, and walks back, so that anything coming up off the grey marsh meets a Warden on the road before it meets a village. He has met three things in twenty years and does not describe them.",
    "unique_habit": "Counts his paces between the Rest and the West Walk every day, aloud, under his breath, and writes the number in the Roll room's margin; it has not been the same number twice in a month.",
    "personality": {
      "traits": [
        "brave",
        "quiet",
        "pious",
        "kind"
      ]
    },
    "appearance": {
      "seed": 9202,
      "build": "broad_weathered",
      "age": 52.0,
      "feminine": 0.0,
      "hair": "iron_grey_cropped",
      "notes": "the Wardens' green over grey mail, a horn at the hip with its mouthpiece worn bright, boots resoled so often the uppers are older than his sergeant"
    },
    "tags": [
      "wayfarer"
    ],
