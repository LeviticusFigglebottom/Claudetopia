           "look": {"place": "core:place/sayers_spire", "height": 32}}
        ],
        "lines": [
          {"at": 0.4, "for": 4.0, "text": "The Sayers say it is a bell, struck once and still ringing."},
          {"at": 4.6, "for": 3.4, "text": "They charge by the hour to explain it."}
