           "look": {"place": "core:place/wardens_rest", "height": 8}}
        ],
        "lines": [
          {"at": 0.4, "for": 2.8, "text": "Everybody agrees what it is doing."},
          {"at": 3.4, "for": 3.6, "text": "A place nobody speaks of goes quiet, and then it goes."},
          {"at": 7.4, "for": 2.6, "text": "We keep their names on the Roll."}
        ]
