          {"t": 1.0, "at": {"place": "core:place/sunken_choir", "bearing": 183, "distance": 300, "height": 25},
           "look": {"place": "core:place/sunken_choir", "height": 28}}
        ],
        "lines": [
          {"at": 0.6, "for": 4.3, "text": "South of everything is Cinderlea, where it has gone furthest."},
          {"at": 5.2, "for": 3.7, "text": "South of that is the Hush, where it has finished."}
        ]
      },
      {
        "id": "the_stair", "duration": 16.0, "time": 7.2, "weather": "core:weather/thin_sun", "fov": 55,
        "handover": true,
        "keys": [
          {"t": 0.0, "at": {"place": "player", "bearing": 180, "distance": 110, "height": 42},
           "look": {"place": "player", "bearing": 0, "distance": 160, "height": 55}},
          {"t": 0.6, "at": {"place": "player", "bearing": 174, "distance": 24, "height": 8},
           "look": {"place": "player", "bearing": 0, "distance": 70, "height": 6}},
          {"t": 1.0, "at": "player_camera"}
        ],
        "lines": [
          {"at": 0.6, "for": 5.4, "text": "I have stood at the top of that stair nineteen years and watched grey people walk down it."},
          {"at": 6.3, "for": 2.4, "text": "Nobody has ever walked up it."},
          {"at": 9.2, "for": 2.6, "text": "Then, this morning, you did."},
          {"at": 12.4, "for": 2.8, "text": "Keep up. I don't look back."}
        ]
      }
    ]
  }
