           "look": {"place": "core:place/cracked_toll", "height": 24}}
        ],
        "lines": [
          {"at": 0.6, "for": 2.8, "text": "This spring the Toll began to hum."},
          {"at": 3.8, "for": 4.3, "text": "The last time it hummed, Gosford went quiet in eleven days."}
        ]
      },
      {
        "id": "the_choir", "duration": 10.0, "time": 16.8, "weather": "core:weather/ashfall", "fov": 55,
        "keys": [
