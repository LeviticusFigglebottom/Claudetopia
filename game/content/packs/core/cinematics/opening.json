[
  {
    "id": "core:cinematic/opening",
    "name": "The Opening",
    "description": "What plays between the Naming and the first step, on a new game (DESIGN 5.1a). The Warden says the name back, then tells the Foundling what they have come up into, over the country itself; the last shot comes down on the Hushline Stair and settles behind their shoulder. Every camera stands relative to a place and to the ground under it.",
    "speaker": "The Warden",
    "letterbox": 2.35,
    "dissolve": 1.4,
    "hold_line": "The Warden waits for you to catch her up.",
    "title_card": {"shot": "the_mere", "at": 1.0, "for": 6.0, "title": "Wickmere", "line": "Everything that is spoken of, stays."},
    "handover": {"time": 7.2, "weather": "core:weather/thin_sun", "facing": {"place": "core:place/sunken_choir"}},
    "shots": [
      {
        "id": "the_name", "duration": 6.0, "black": true,
        "lines": [
          {"at": 0.6, "for": 1.6, "text": "{name}."},
          {"at": 2.4, "for": 3.3, "text": "There. Said out loud, and heard. That is how it holds."}
        ]
      },
      {
