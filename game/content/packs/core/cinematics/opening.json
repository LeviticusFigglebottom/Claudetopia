          {"t": 1.0, "at": {"place": "core:place/drowned_nave", "bearing": 108, "distance": 330, "height": 24},
           "look": {"place": "core:place/drowned_nave", "height": 58}}
        ],
        "lines": [
          {"at": 0.8, "for": 3.4, "text": "The marsh says it is a tide going out."}
