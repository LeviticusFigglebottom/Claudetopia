  {
    "id": "core:roadevent/briarwold_cider_cart",
    "name": "Tamwick's cider cart",
    "kind": "caravan",
    "notes": "The Hollow buys Tamwick's cider and will not take it without a gift going back, which is custom: the Bread Stone on the Wold road is where the gift is left. The cart comes up the Wold road and slows at the Drunk Stones' bend.",
    "speed": 1.2,
    "cast": [
      {
        "role": "trader",
        "enemy": "core:enemy/road_trader",
        "talk": {
          "prompt": "Trade with the cider-carter",
          "do": "trade",
          "say": "Tamwick's best, for the Hollow. The Hollow sends bread back down, and I eat it on the way, and nobody minds. What'll you have?"
        }
      },
      {
        "role": "guard",
        "enemy": "core:enemy/caravan_guard",
        "talk": {
          "prompt": "Talk to the guard",
          "do": "say",
          "say": "Mind the bend at the Drunk Stones. Carts slow there. So do the ones who wait for carts."
        }
      }
    ],
    "train": {
      "kind": "wagon",
      "goods": "core:loot/common_chest"
    },
    "merchant": {
      "stock": "core:table/stock_carters_load",
      "marks": 200,
      "buys": [
        "consumable",
        "ingredient",
        "misc"
      ]
    },
    "consequence": {
      "faction": "core:faction/tallymen",
      "reputation": -8,
      "killing": -15,
      "notice": "Tamwick will hear its cider cart was set on.",
      "killing_notice": "A Tamwick carter's man is dead on the Wold road."
    },
    "rescue": {
      "say": "They'd have had the barrels and the horse. Here, a jug for your trouble, and a fair price from me any day.",
      "marks": 20,
      "reputation": {
        "faction": "core:faction/tallymen",
        "delta": 4
      }
    }
  },
  {
    "id": "core:roadevent/briarwold_oil_train",
    "name": "The Moot's oil-train",
    "kind": "caravan",
    "notes": "The Standing Moot's stones are oiled by hand every week, and the oil comes up from Fernhold on a packhorse, jars in straw.",
    "speed": 1.15,
    "cast": [
      {
        "role": "trader",
        "enemy": "core:enemy/road_trader",
        "talk": {
          "prompt": "Talk to the oil-carrier",
          "do": "trade",
          "say": "Oil for the stones, mostly. What's over I'll sell. Candles, rope, a jar for your lamp. Tending's work, and work wants paying."
        }
      },
      {
        "role": "guard",
        "enemy": "core:enemy/woodfolk_hunter",
        "talk": {
          "prompt": "Talk to the hunter",
          "do": "say",
          "say": "*She walks beside the horse and says nothing, and then, because you are still there:* The stones don't need guarding. The oil does."
        }
      }
    ],
    "train": {
      "kind": "packhorse",
      "goods": "core:loot/pockets_merchant"
    },
    "merchant": {
      "stock": "core:table/stock_hollow_trader",
      "marks": 160,
      "buys": [
        "consumable",
        "ingredient",
        "material",
        "misc"
      ]
    },
    "consequence": {
      "faction": "core:faction/woodfolk",
      "reputation": -10,
      "killing": -20,
      "notice": "You set on the Moot's oil. The Woodfolk will not forget it.",
      "killing_notice": "The Moot's oil-carrier lies dead on the road, and the stones will go dry this week."
    },
    "rescue": {
      "say": "The jars are whole. The stones will be oiled. — That's all that matters, and it's a great deal. Take this.",
      "marks": 15,
      "reputation": {
        "faction": "core:faction/woodfolk",
        "delta": 5
      }
    }
  },
  {
    "id": "core:roadevent/briarwold_unvowed_huntsmen",
    "name": "Unvowed huntsmen with a hart",
    "kind": "patrol",
    "speed": 1.2,
    "cast": [
      {
        "role": "huntsman",
        "enemy": "core:enemy/unvowed_huntsman",
        "count": [
