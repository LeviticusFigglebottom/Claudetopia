  {
    "id": "core:roadevent/briarwold_woodfolk_hunters",
    "name": "Woodfolk hunters on the road",
    "kind": "patrol",
    "speed": 1.4,
    "cast": [
      {
        "role": "hunter",
        "enemy": "core:enemy/woodfolk_hunter",
        "count": [
          2,
          3
        ],
        "talk": {
          "prompt": "Talk to the hunter",
          "do": "say",
          "say": "*She looks at what you are carrying before she looks at you.* — Go on. — The poachers take the harts at the Hartswell at first light, since you're walking that way. Nobody says so. I'm not saying so.",
          "hook": {
            "rumour": "The Woodfolk hunter did not say that the poachers wait at {place}.",
            "reveals": "core:poi/hartswell",
            "once": true
          }
        }
      }
    ],
    "consequence": {
      "faction": "core:faction/woodfolk",
      "reputation": -12,
      "killing": -25,
      "notice": "The Woodfolk say nothing. They will remember your face for a long time.",
      "killing_notice": "A Woodfolk hunter is dead on the road. Custom has nothing to say about it. The Hollow will."
    }
  },
  {
    "id": "core:roadevent/briarwold_hart_knight",
    "name": "A Hart-Knight on the road",
    "kind": "wanderer",
    "speed": 1.0,
    "cast": [
      {
        "role": "knight",
        "enemy": "core:enemy/hart_knight_wayfarer",
        "talk": {
          "prompt": "Speak to the knight",
          "do": "say",
          "say": "*He lowers his head, antlers and all, to look at what you carry.* — No heads. Good. — If you pass the Tine Barrow below Moot Tor, go by day. The first knights walk after midnight, and they do not know you.",
          "hook": {
            "reveals": "core:poi/tine_barrow",
            "once": true
          }
        }
      }
    ],
    "consequence": {
      "faction": "core:faction/woodfolk",
      "reputation": -10,
      "killing": -20,
      "notice": "You struck a Hart-Knight on the Wold's road. The Woodfolk saw.",
      "killing_notice": "A Hart-Knight lies dead on the road, antlers in the bracken."
    }
  },
  {
    "id": "core:roadevent/briarwold_oil_carriers",
    "name": "Oil-carriers going up to the Moot",
    "kind": "pilgrims",
    "speed": 0.95,
    "cast": [
      {
        "role": "carrier",
        "folk": {
          "name": "An oil-carrier",
          "tags": [
            "person",
            "pilgrim"
          ]
        },
        "count": [
          2,
          3
        ],
        "talk": {
          "prompt": "Talk to the oil-carrier",
          "do": "say",
          "say": "Oil for the Moot's stones. Every week, from Fernhold, a jar each, and back empty. Oiling is tending, and tending keeps the note. — The stones hum when you stand in the middle. Don't stand in the middle.",
          "hook": {
            "rumour": "The oil-carriers go up past {place} every week.",
            "reveals": "nearest:standing_stones",
            "once": true
          }
        }
      }
    ]
  },
  {
    "id": "core:roadevent/briarwold_moss_bearers",
    "name": "Mourners with a moss",
    "kind": "pilgrims",
    "speed": 0.8,
    "cast": [
      {
        "role": "mourner",
        "folk": {
          "name": "A mourner",
          "tags": [
            "person"
          ]
        },
        "count": [
          2,
          4
        ],
        "talk": {
          "prompt": "Speak to the mourners",
          "do": "say",
          "say": "*They carry a flat of moss between them on a hurdle, green and wet, and do not stop walking.* — Star-moss, hair-moss, feather-moss. For my father. We start it at the Moss Bed and carry it to him. — You may walk with us. You needn't say anything. Nobody does.",
          "hook": {
            "reveals": "core:poi/moss_bed",
            "once": true
          }
        }
      }
    ]
  },
  {
    "id": "core:roadevent/briarwold_lost_child",
    "name": "A child lost in the bracken",
    "kind": "lost_traveller",
    "cast": [
      {
        "role": "child",
        "folk": {
          "name": "A woodfolk child",
          "tags": [
            "person",
            "child"
          ],
          "appearance": {
            "age": 10
          }
        },
        "pose": "Sit_Idle",
        "talk": {
          "prompt": "Ask the child what's wrong",
          "do": "escort",
          "say": "I was following a hart. It went into the bracken and so did I and now the bracken's everywhere. — Do you know the way to {place}? I'm not crying. It's the bracken.",
          "thanks": "That's our smoke! — Thank you. Here, I found it in the bracken; it's lucky. Don't tell Mum I went after the hart.",
          "hook": {
            "item": "core:item/shed_antler",
            "count": 1,
            "reputation": {
              "faction": "core:faction/woodfolk",
              "delta": 4
            }
          }
        }
      }
    ]
  },
  {
    "id": "core:roadevent/briarwold_runaway_poacher",
    "name": "A poacher running",
    "kind": "fugitive",
    "speed": 1.4,
    "cast": [
      {
        "role": "fugitive",
        "folk": {
          "name": "A poacher running",
          "tags": [
            "person"
          ]
        },
        "talk": {
          "prompt": "Let the poacher past",
          "do": "help",
          "say": "They'll not hurt me, they never do, they just follow, for days, saying nothing. — Here. Take it. There's a pale in the Greatwood that pays for heads. Go and see what it pays. Go and see what they sell them for.",
          "hook": {
            "marks": 10,
            "rumour": "The runaway poacher said the heads go to {place}.",
            "reveals": "core:poi/horn_pale",
            "once": true
          }
        }
      },
      {
        "role": "hunter",
        "enemy": "core:enemy/woodfolk_hunter",
        "count": 2,
        "talk": {
          "prompt": "Point the hunters after the poacher",
          "do": "turn_in",
          "say": "*She nods once and goes on after him, and does not thank you, and the other one does.*",
          "hook": {
            "marks": 15,
            "reputation": {
              "faction": "core:faction/woodfolk",
              "delta": 5
            }
          }
        }
      }
    ],
    "consequence": {
      "faction": "core:faction/woodfolk",
      "reputation": -12,
      "killing": -25,
      "notice": "You struck a Woodfolk hunter. They say nothing, and they will not forget.",
      "killing_notice": "A Woodfolk hunter lies dead on the road."
    }
  },
  {
