        ],
        "hostile": true
      }
    ],
    "lines": {
      "speaker": "An Unvowed huntsman",
      "spring": "Tinehold's road! The Marshal's meat! Off it!"
    }
  },
  {
    "id": "core:roadevent/briarwold_penhallows_courier",
    "name": "The Charter Company's courier",
    "kind": "wanderer",
    "speed": 1.1,
    "cast": [
      {
        "role": "courier",
        "folk": {
          "name": "A Company courier",
          "tags": [
            "tallymen"
          ]
        },
        "talk": {
          "prompt": "Speak to the courier",
          "do": "say",
          "say": "Quarter-day pay for a clerk at a mine nobody works. Every quarter. The Company's forgotten it owns the Delf and nobody's told the paymaster. — Up by the Builders' quarry. You'll see the wheel over the trees. He'll weigh your hand before he shakes it.",
          "hook": {
            "reveals": "core:poi/charter_delf",
            "once": true
          }
        }
      }
    ]
  },
  {
    "id": "core:roadevent/briarwold_burners_to_the_brother",
    "name": "Burners going up to the Windthrow",
    "kind": "pilgrims",
    "speed": 1.0,
    "cast": [
      {
        "role": "burner",
        "folk": {
          "name": "A charcoal-burner",
          "tags": [
            "woodfolk"
          ]
        },
        "count": [
          2,
          2
        ],
        "talk": {
          "prompt": "Speak to the burner",
          "do": "say",
          "say": "Up to the Windthrow with bread for Jory Rooke. He's sat at the pit a month with his uncle's mark and his own axe. — The Brother's ours by the verderer's mark. Nobody'll cut it. You'll see the plate from the Hollow road, stood up over the oaks like a door.",
          "hook": {
            "reveals": "core:poi/the_windthrow",
            "once": true
          }
        }
      }
    ]
  },
  {
    "id": "core:roadevent/briarwold_swarm_on_the_post",
    "name": "A swarm on the fingerpost",
    "kind": "lost_traveller",
    "cast": [
      {
        "role": "keeper",
        "folk": {
          "name": "A girl with an empty skep",
          "tags": [
            "woodfolk"
          ],
          "appearance": {
            "age": 15
          }
        },
        "pose": "Sit_Idle",
        "talk": {
          "prompt": "Help her take the swarm",
          "do": "help",
